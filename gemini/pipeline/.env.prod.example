# Settings for docker-compose.prod.yaml. The GEMINI desktop app writes the
# real file (with generated secrets) into its app-data folder at first run;
# this template documents every key. Never commit a filled-in copy.

# ── Release and paths ─────────────────────────────────────────────────────
GEMINI_VERSION=0.0.0
GEMINI_IMAGE_REGISTRY=ghcr.io/gemini-breeding
# Absolute path of THIS file (services load it with env_file).
GEMINI_ENV_FILE=/path/to/gemini.env
# Where the stack keeps its data: postgres/, minio/, redis/, nodeodm/.
GEMINI_DATA_DIR=/path/to/GEMI-Data/stack
# Optional: `gemini_db` keeps Postgres in a Docker volume instead of
# ${GEMINI_DATA_DIR}/postgres (Windows: Postgres can't run on NTFS mounts).
# GEMINI_DB_MOUNT=gemini_db

# ── Ports on this machine (127.0.0.1 only) ────────────────────────────────
GEMINI_REST_API_HOST_PORT=7777
GEMINI_TITILER_HOST_PORT=8091

# ── Service addresses inside the stack (don't change) ─────────────────────
GEMINI_DB_HOSTNAME=geminibase-db
GEMINI_DB_PORT=5432
GEMINI_LOGGER_HOSTNAME=geminibase-logger
GEMINI_LOGGER_PORT=6379
GEMINI_STORAGE_HOSTNAME=geminibase-storage
GEMINI_STORAGE_PORT=9000
GEMINI_STORAGE_API_PORT=9001
GEMINI_REST_API_HOSTNAME=geminibase-rest-api
GEMINI_REST_API_PORT=7777

# ── Secrets: generate per install (random, ≥ 32 characters) ──────────────
GEMINI_DB_USER=gemini
GEMINI_DB_NAME=gemini
GEMINI_DB_PASSWORD=
GEMINI_LOGGER_PASSWORD=
GEMINI_STORAGE_ROOT_USER=gemini_root
GEMINI_STORAGE_ROOT_PASSWORD=
GEMINI_STORAGE_ACCESS_KEY=gemini_storage_user
GEMINI_STORAGE_SECRET_KEY=
GEMINI_STORAGE_BUCKET_NAME=gemini
GEMINI_JWT_SECRET=
GEMINI_JWT_ALGORITHM=HS256
GEMINI_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=11520

# The install's own account: the app signs in with it automatically, and
# the workers use it to talk to the API.
GEMINI_FIRST_SUPERUSER_EMAIL=
GEMINI_FIRST_SUPERUSER_PASSWORD=
GEMINI_FIRST_SUPERUSER_FULL_NAME=GEMINI User
